# ============================================================
#  cloud_api — example environment variables
#  Copy this file to ".env" and fill in real values.
#  The real ".env" is git-ignored and must NEVER be committed.
#  On Render, set these in the dashboard (Environment tab) instead.
# ============================================================

# --- LLM (HuggingFace router -> Pathumma) ---
# HuggingFace access token, starts with "hf_". Required for live chat replies.
LLM_API_KEY=
# Alternative name read as a fallback if LLM_API_KEY is empty.
HF_TOKEN=
# Model / provider id used for inference.
LLM_MODEL=nectec/Pathumma-llm-text-1.0.0:featherless-ai
# OpenAI-compatible base URL for the inference router.
LLM_BASE_URL=https://router.huggingface.co/v1

# --- RAG retrieval ---
# Number of knowledge snippets retrieved per question.
RAG_TOP_K=3
# Minimum similarity score for a snippet to be used.
RAG_MIN_SCORE=0.0

# --- Firestore (optional persistent storage) ---
# Set to "1"/"true"/"yes" to store events in Firestore instead of memory.
USE_FIRESTORE=
# Collection name prefix for stored events.
FIRESTORE_COLLECTION_PREFIX=vita_guard

# --- Server ---
# Render injects PORT automatically; only set locally if needed.
# PORT=8000

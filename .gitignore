# ============================================================
#  doz / VitaGuard — .gitignore
# ============================================================

# --- Misc / OS ---
*.class
*.log
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# --- IDE (IntelliJ / Android Studio) ---
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ============================================================
#  Flutter / Dart / Pub
# ============================================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release
android/local.properties
android/.gradle/
android/.kotlin/
android/key.properties
*.jks
*.keystore

# iOS / macOS generated
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
macos/Flutter/ephemeral/
**/Pods/

# ============================================================
#  Python backend (cloud_api/)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env
*.env
!*.env.example
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ============================================================
#  Project-specific (not for version control)
# ============================================================
outputs/
work/
smart_health_risk_alert_watch/

# Cloud service account credentials — NEVER commit
*-service-account*.json
google-credentials*.json
serviceAccount*.json

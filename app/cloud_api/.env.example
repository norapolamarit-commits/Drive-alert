# ============================================================
#  cloud_api — example environment variables
#  Copy this file to ".env" and fill in real values.
#  The real ".env" is git-ignored and must NEVER be committed.
#  On Render, set these in the dashboard (Environment tab) instead.
# ============================================================

# --- LLM (HuggingFace router -> Pathumma) ---
# HuggingFace access token, starts with "hf_". Required for live chat replies.
LLM_API_KEY=
# Alternative name read as a fallback if LLM_API_KEY is empty.
HF_TOKEN=
# Model / provider id used for inference.
LLM_MODEL=nectec/Pathumma-llm-text-1.0.0:featherless-ai
# OpenAI-compatible base URL for the inference router.
LLM_BASE_URL=https://router.huggingface.co/v1

# --- Supabase authentication for AI endpoints (/chat and /advice) ---
# Required for chat deployment. Never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key required for DELETE /account. Never add it to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- RAG retrieval ---
# Number of knowledge snippets retrieved per question.
RAG_TOP_K=3
# Minimum similarity score for a snippet to be used.
RAG_MIN_SCORE=0.0

# --- In-process AI abuse / capacity guard (shared by /chat and /advice) ---
# Total authenticated AI requests per account during the sliding time window.
AI_RATE_LIMIT_MAX=20
# Sliding-window duration in seconds.
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum simultaneous chat/advice requests in this API process.
AI_MAX_CONCURRENT_REQUESTS=2
# These are process-local; configure a shared gateway/provider limiter before
# operating multiple API replicas or opening a public production service.

# --- Health-data cloud sync ---
# Keep disabled until retention, access control, ownership, and deletion are reviewed.
HEALTH_DATA_SYNC_ENABLED=false

# --- Firestore (optional persistent storage) ---
# Set to "1"/"true"/"yes" to store events in Firestore instead of memory.
USE_FIRESTORE=
# Collection name prefix for stored events.
FIRESTORE_COLLECTION_PREFIX=vita_guard

# --- Server ---
# Render injects PORT automatically; only set locally if needed.
# PORT=8000
